generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Jugador {
  id           Int      @id @default(autoincrement())
  nombre       String
  activo       Boolean  @default(true)
  media        Int?
  fotoUrl      String?
  equipo       String?
  nacionalidad String?  // código ISO de 2 letras, ej: "AR", "BR", "ES"
  createdAt    DateTime @default(now())

  participaciones ParticipacionPartido[]
}

model Partido {
  id           Int      @id @default(autoincrement())
  fecha        DateTime
  cancha       String?
  golesEquipoA Int
  golesEquipoB Int
  createdAt    DateTime @default(now())

  participaciones ParticipacionPartido[]
}

model ParticipacionPartido {
  id        Int    @id @default(autoincrement())
  partidoId Int
  jugadorId Int
  equipo    String // "A" o "B"
  goles     Int    @default(0)

  partido Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  jugador Jugador @relation(fields: [jugadorId], references: [id])

  @@unique([partidoId, jugadorId])
}
